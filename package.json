{
  "name": "xigma",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "generate:font-atlas": "msdf-bmfont -f json -t msdf -s 64 -r 6 -p 2 -i src/assets/fonts/inter/inter-msdf.charset.txt -o src/assets/fonts/inter/inter-msdf src/assets/fonts/inter/source/Inter-Regular.ttf && mv src/assets/fonts/inter/Inter-Regular.json src/assets/fonts/inter/inter-msdf.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint:check": "stylelint \"**/*.scss\"",
    "stylelint:fix": "stylelint \"**/*.scss\" --fix",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "classnames": "^2.5.1",
    "i18next": "^26.3.6",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "msdf-bmfont-xml": "^2.8.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
